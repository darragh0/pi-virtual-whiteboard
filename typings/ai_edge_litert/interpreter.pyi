from typing import TypedDict

import numpy as np
import numpy.typing as npt

class TensorDetails(TypedDict):
    name: str
    index: int
    shape: npt.NDArray[np.int32]

class Interpreter:
    def __init__(self, model_path: str | None = None, num_threads: int | None = None) -> None: ...
    def allocate_tensors(self) -> None: ...
    def get_input_details(self) -> list[TensorDetails]: ...
    def get_output_details(self) -> list[TensorDetails]: ...
    def set_tensor(self, tensor_index: int, value: npt.NDArray[np.float32]) -> None: ...
    def get_tensor(self, tensor_index: int) -> npt.NDArray[np.float32]: ...
    def invoke(self) -> None: ...
